---
/**
 * Footer component for minimal static blog.
 */
---

<footer class="bg-secondary text-gray-200 py-6 mt-10">
  <div class="container flex flex-col sm:flex-row justify-between items-center gap-4">
    <span class="text-xs font-medium tracking-wide">&copy; {new Date().getFullYear()} My Astro Blog</span>
    <a href="https://astro.build" class="text-accent font-semibold hover:underline focus:underline focus:outline-none">
      Powered by Astro
    </a>
  </div>
</footer>

---
/**
 * Header: Site navigation bar for the blog.
 */
const siteTitle = "Astro Minimal Blog";
---

<header class="header">
  <div class="container">
    <a href="/" class="site-title">{siteTitle}</a>
    <nav>
      <a href="/" aria-label="Home">Home</a>
      <a href="/about" aria-label="About">About</a>
      <a href="/contact" aria-label="Contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .header {
    background: var(--bg-color);
    border-bottom: 1px solid var(--border-color);
    padding: 0.5rem 0;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
  }
  .site-title {
    font-weight: bold;
    font-size: 1.35rem;
    color: #1a202c;
    letter-spacing: 1px;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.2rem;
  }
  nav a {
    color: #4a5568;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }
  nav a:hover {
    color: #2563eb;
  }
  @media (max-width: 600px) {
    .container { flex-direction: column; align-items: flex-start; }
    nav { margin-top: 7px; }
  }
</style>

---
/**
 * BlogCard component for previewing blog posts on the homepage.
 * Props:
 *  - title: string
 *  - description: string
 *  - pubDate: string (preferably ISO)
 *  - href: string (URL of the blog post)
 */
const { title, description, pubDate, href } = Astro.props;
---

<article class="card h-full overflow-hidden">
  <a href={href} class="p-6 grow flex flex-col focus:outline-none focus:ring-2 focus:ring-accent rounded-lg transition">
    <h2 class="text-lg font-bold text-primary mb-1 line-clamp-2">{title}</h2>
    <time datetime={pubDate} class="text-xs text-gray-400 mb-2">{pubDate}</time>
    <p class="text-base text-secondary line-clamp-3 mb-auto">{description}</p>
    <span class="mt-4 text-accent font-semibold inline-block hover:underline">
      Read more <span aria-hidden="true">→</span>
    </span>
  </a>
</article>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Minimal Blog</title>
  </head>
  <body>
    <ThemeToggle />
    <Header />
    <main class="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  :root {
    /* Light theme variables */
    --bg-color: #ffffff;
    --text-color: #1a202c;
    --text-secondary: #4a5568;
    --border-color: rgba(0, 0, 0, 0.09);
    --card-bg: #fff;
    --card-hover-bg: #f1f5f9;
    --shadow-color: rgba(0, 0, 0, 0.08);
    --shadow-hover-color: rgba(37, 99, 235, 0.07);
    --accent: #2563eb;
  }
  body.dark-theme {
    /* (Optional) dark theme support */
    --bg-color: #f7fafc;
    --text-color: #111827;
    --text-secondary: #4b5563;
    --border-color: rgba(60, 60, 60, 0.11);
    --card-bg: #f1f5f9;
    --card-hover-bg: #e2e8f0;
    --shadow-color: rgba(37, 99, 235, 0.05);
    --shadow-hover-color: rgba(37, 99, 235, 0.07);
    --accent: #2563eb;
  }
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
    background-color: var(--bg-color);
    color: var(--text-color);
    transition: background-color 0.24s, color 0.2s;
    font-family: Inter, Roboto, Arial, sans-serif;
    font-size: 1rem;
  }
  .main-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 1.8rem 1.2rem 1.2rem 1.2rem;
    min-height: 68vh;
  }
</style>

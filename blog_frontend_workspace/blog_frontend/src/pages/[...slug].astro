---
import Layout from '../layouts/Layout.astro';

// PUBLIC_INTERFACE
export async function getStaticPaths() {
  // Use import.meta.glob to generate all posts
  const allPostFiles = import.meta.glob('../posts/*.md');
  const paths = [];

  // Each key in allPostFiles is the relative path (e.g. ../posts/hello-astro.md).
  for (const file in allPostFiles) {
    // Remove ../posts/ and .md to get filename
    const filename = file.split('/').pop().replace(/\.md$/, '');
    // Support multi-segment slugs (if you want subfolders, e.g. posts/year/slug.md)
    const slugArr = filename.split('/');
    paths.push({ params: { slug: slugArr } });
  }
  return paths;
}

const { slug } = Astro.params;
// Use import.meta.glob to load all posts
const allPostFiles = import.meta.glob('../posts/*.md', { eager: true });
// Match the post based on slug. (slug can be array or string)
const urlSlug = Array.isArray(slug) ? slug.join('/') : slug;

// Each import result shape: { frontmatter, url, Content }
let post = null;
for (const [path, mod] of Object.entries(allPostFiles)) {
  // Remove "../posts/" and ".md" from the filename
  const filename = path.split('/').pop().replace(/\.md$/, '');
  if (filename === urlSlug) {
    post = mod;
    break;
  }
}

// If not found, error
if (!post) {
  throw new Error('Blog post not found');
}
const { title, pubDate, description } = post.frontmatter;
// Astro v3 native markdown rendering: post.Content is a component that renders the markdown
---

<Layout>
  <article class="post-paper">
    <a href="/" class="back-link">← All Posts</a>
    <h1 class="post-title">{title}</h1>
    <time class="post-date" datetime={pubDate}>{new Date(pubDate).toLocaleDateString()}</time>
    {description && <p class="post-desc">{description}</p>}
    <div class="post-content">
      <post.Content />
    </div>
  </article>
</Layout>

<style>
  .post-paper {
    max-width: 740px;
    margin: 0 auto;
    padding: 2.2rem 1rem 2rem 1rem;
    background: var(--card-bg);
    border-radius: 12px;
    box-shadow: 0 2px 9px var(--shadow-color);
    border: 1px solid var(--border-color);
  }
  .post-title {
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 0.25em;
    color: #1a202c;
  }
  .post-date { color: #4a5568; font-size: 1rem; margin-bottom: 1.3em; display: block; }
  .back-link {
    text-decoration: none;
    color: #2563eb;
    font-size: 1rem;
    margin-bottom: 1rem;
    display: inline-block;
    transition: color 0.18s;
  }
  .back-link:hover { color: #1a202c; }
  .post-desc {
    color: #4a5568;
    margin: 1rem 0 2rem 0;
    font-size: 1.08rem;
  }
  .post-content :global(p) {
    line-height: 1.7;
    font-size: 1.08rem;
    margin-bottom: 1em;
    color: var(--text-secondary);
  }
  .post-content :global(h2),
  .post-content :global(h3) {
    color: #1a202c;
    margin-top: 1.2em;
    margin-bottom: 0.45em;
  }
  .post-content :global(code) {
    background: #f3f4f6;
    border-radius: 6px;
    padding: 2px 7px;
    font-size: 0.95em;
  }
  .post-content :global(pre) {
    background: #e6edf3;
    border-radius: 9px;
    padding: 1em;
    overflow-x: auto;
  }
  .post-content :global(a) {
    color: #2563eb;
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .post-paper { padding: 1rem 0.5rem; }
    .post-title { font-size: 1.35rem; }
  }
</style>

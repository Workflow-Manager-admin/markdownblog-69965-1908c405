---
import BaseLayout from "../components/BaseLayout.astro";
/**
 * About page for static blog.
 */
---

<BaseLayout title="About | My Astro Blog">
  <section class="container max-w-2xl mx-auto bg-white rounded-lg shadow p-8 mt-10">
    <h1 class="text-2xl font-bold mb-4">About</h1>
    <p>
      Welcome to <b>My Astro Blog</b>!<br />
      This is a minimal, responsive static blog built with Astro.  
    </p>
    <p class="mt-6 text-secondary">
      Posts are written in Markdown.  
      This static site was generated using Astro for learning and demonstration purposes.
    </p>
  </section>
</BaseLayout>

---
import BaseLayout from "../components/BaseLayout.astro";
/**
 * Contact page for static blog.
 */
---

<BaseLayout title="Contact | My Astro Blog">
  <section class="container max-w-2xl mx-auto mt-10">
    <h1 class="text-2xl font-bold mb-4">Contact</h1>
    <p>
      Have questions or want to reach out?<br>
      You can email us at <a href="mailto:hello@example.com" class="text-accent font-semibold">hello@example.com</a>.
    </p>
    <p class="mt-6 text-secondary">
      This is a static sample. For a real blog, you could add a contact form here.
    </p>
  </section>
</BaseLayout>
